;
; tcp-server.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = tcp-server.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
tcp-server.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%tcp-server.DeviceDesc% = tcp-server_Device, Root\tcp-server ; TODO: edit hw-id

[tcp-server_Device.NT]
CopyFiles = File_Copy

[File_Copy]
tcp-server.sys

;-------------- Service installation
[tcp-server_Device.NT.Services]
AddService = tcp-server,%SPSVCINST_ASSOCSERVICE%, tcp-server_Service_Inst

; -------------- tcp-server driver install sections
[tcp-server_Service_Inst]
DisplayName    = %tcp-server.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\tcp-server.sys

[tcp-server_Device.NT.Wdf]
KmdfService = tcp-server, tcp-server_wdfsect

[tcp-server_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "tcp-server Installation Disk"
tcp-server.DeviceDesc = "tcp-server Device"
tcp-server.SVCDESC = "tcp-server Service"
