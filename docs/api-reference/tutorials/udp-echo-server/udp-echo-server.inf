;
; udp-echo-server.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = udp-echo-server.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
udp-echo-server.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%udp-echo-server.DeviceDesc% = udp-echo-server_Device, Root\udp-echo-server ; TODO: edit hw-id

[udp-echo-server_Device.NT]
CopyFiles = File_Copy

[File_Copy]
udp-echo-server.sys

;-------------- Service installation
[udp-echo-server_Device.NT.Services]
AddService = udp-echo-server,%SPSVCINST_ASSOCSERVICE%, udp-echo-server_Service_Inst

; -------------- udp-echo-server driver install sections
[udp-echo-server_Service_Inst]
DisplayName    = %udp-echo-server.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\udp-echo-server.sys

[udp-echo-server_Device.NT.Wdf]
KmdfService = udp-echo-server, udp-echo-server_wdfsect

[udp-echo-server_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "udp-echo-server Installation Disk"
udp-echo-server.DeviceDesc = "udp-echo-server Device"
udp-echo-server.SVCDESC = "udp-echo-server Service"
