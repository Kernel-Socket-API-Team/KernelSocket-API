;
; scopeIdParsingTestDriver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = scopeIdParsingTestDriver.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
scopeIdParsingTestDriver.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%scopeIdParsingTestDriver.DeviceDesc% = scopeIdParsingTestDriver_Device, Root\scopeIdParsingTestDriver ; TODO: edit hw-id

[scopeIdParsingTestDriver_Device.NT]
CopyFiles = File_Copy

[File_Copy]
scopeIdParsingTestDriver.sys

;-------------- Service installation
[scopeIdParsingTestDriver_Device.NT.Services]
AddService = scopeIdParsingTestDriver,%SPSVCINST_ASSOCSERVICE%, scopeIdParsingTestDriver_Service_Inst

; -------------- scopeIdParsingTestDriver driver install sections
[scopeIdParsingTestDriver_Service_Inst]
DisplayName    = %scopeIdParsingTestDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\scopeIdParsingTestDriver.sys

[scopeIdParsingTestDriver_Device.NT.Wdf]
KmdfService = scopeIdParsingTestDriver, scopeIdParsingTestDriver_wdfsect

[scopeIdParsingTestDriver_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "scopeIdParsingTestDriver Installation Disk"
scopeIdParsingTestDriver.DeviceDesc = "scopeIdParsingTestDriver Device"
scopeIdParsingTestDriver.SVCDESC = "scopeIdParsingTestDriver Service"
