;
; driverTestPorts.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = driverTestPorts.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
driverTestPorts.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%driverTestPorts.DeviceDesc% = driverTestPorts_Device, Root\driverTestPorts ; TODO: edit hw-id

[driverTestPorts_Device.NT]
CopyFiles = File_Copy

[File_Copy]
driverTestPorts.sys

;-------------- Service installation
[driverTestPorts_Device.NT.Services]
AddService = driverTestPorts,%SPSVCINST_ASSOCSERVICE%, driverTestPorts_Service_Inst

; -------------- driverTestPorts driver install sections
[driverTestPorts_Service_Inst]
DisplayName    = %driverTestPorts.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\driverTestPorts.sys

[driverTestPorts_Device.NT.Wdf]
KmdfService = driverTestPorts, driverTestPorts_wdfsect

[driverTestPorts_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "driverTestPorts Installation Disk"
driverTestPorts.DeviceDesc = "driverTestPorts Device"
driverTestPorts.SVCDESC = "driverTestPorts Service"
