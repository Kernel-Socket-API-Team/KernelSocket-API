;
; igorifooopii.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = igorifooopii.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
igorifooopii.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%igorifooopii.DeviceDesc% = igorifooopii_Device, Root\igorifooopii ; TODO: edit hw-id

[igorifooopii_Device.NT]
CopyFiles = File_Copy

[File_Copy]
igorifooopii.sys

;-------------- Service installation
[igorifooopii_Device.NT.Services]
AddService = igorifooopii,%SPSVCINST_ASSOCSERVICE%, igorifooopii_Service_Inst

; -------------- igorifooopii driver install sections
[igorifooopii_Service_Inst]
DisplayName    = %igorifooopii.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\igorifooopii.sys

[igorifooopii_Device.NT.Wdf]
KmdfService = igorifooopii, igorifooopii_wdfsect

[igorifooopii_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "igorifooopii Installation Disk"
igorifooopii.DeviceDesc = "igorifooopii Device"
igorifooopii.SVCDESC = "igorifooopii Service"
