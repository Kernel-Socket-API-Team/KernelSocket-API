;
; testDriverSend.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = testDriverSend.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
testDriverSend.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%testDriverSend.DeviceDesc% = testDriverSend_Device, Root\testDriverSend ; TODO: edit hw-id

[testDriverSend_Device.NT]
CopyFiles = File_Copy

[File_Copy]
testDriverSend.sys

;-------------- Service installation
[testDriverSend_Device.NT.Services]
AddService = testDriverSend,%SPSVCINST_ASSOCSERVICE%, testDriverSend_Service_Inst

; -------------- testDriverSend driver install sections
[testDriverSend_Service_Inst]
DisplayName    = %testDriverSend.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\testDriverSend.sys

[testDriverSend_Device.NT.Wdf]
KmdfService = testDriverSend, testDriverSend_wdfsect

[testDriverSend_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "testDriverSend Installation Disk"
testDriverSend.DeviceDesc = "testDriverSend Device"
testDriverSend.SVCDESC = "testDriverSend Service"
