;
; addresToStringCommonParse.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = addresToStringCommonParse.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
addresToStringCommonParse.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%addresToStringCommonParse.DeviceDesc% = addresToStringCommonParse_Device, Root\addresToStringCommonParse ; TODO: edit hw-id

[addresToStringCommonParse_Device.NT]
CopyFiles = File_Copy

[File_Copy]
addresToStringCommonParse.sys

;-------------- Service installation
[addresToStringCommonParse_Device.NT.Services]
AddService = addresToStringCommonParse,%SPSVCINST_ASSOCSERVICE%, addresToStringCommonParse_Service_Inst

; -------------- addresToStringCommonParse driver install sections
[addresToStringCommonParse_Service_Inst]
DisplayName    = %addresToStringCommonParse.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\addresToStringCommonParse.sys

[addresToStringCommonParse_Device.NT.Wdf]
KmdfService = addresToStringCommonParse, addresToStringCommonParse_wdfsect

[addresToStringCommonParse_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "addresToStringCommonParse Installation Disk"
addresToStringCommonParse.DeviceDesc = "addresToStringCommonParse Device"
addresToStringCommonParse.SVCDESC = "addresToStringCommonParse Service"
